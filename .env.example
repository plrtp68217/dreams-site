# Copy to .env and fill in:  cp .env.example .env

# Signing key for logins. Generate once and keep it: openssl rand -base64 48
DREAMS_SECRET_KEY=

# Administrator created on first start (change the password after logging in)
DREAMS_ADMIN_USERNAME=admin
DREAMS_ADMIN_PASSWORD=

# Self-registration. Anyone who registers gets read access to the scenario, so on a public
# server keep it off and create accounts in «Пользователи и роли».
DREAMS_ALLOW_REGISTRATION=false

# How long a login lasts, in minutes (7 days)
DREAMS_TOKEN_TTL_MINUTES=10080

# Port on 127.0.0.1 that host nginx proxies to
WEB_PORT=8080
